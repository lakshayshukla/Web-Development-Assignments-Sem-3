{
  "info": {
    "name": "Student Management REST API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [{ "key": "baseUrl", "value": "http://localhost:3000" }],
  "item": [
    {
      "name": "Get all students",
      "request": { "method": "GET", "url": "{{baseUrl}}/students" }
    },
    {
      "name": "Get student by id",
      "request": { "method": "GET", "url": "{{baseUrl}}/students/1" }
    },
    {
      "name": "Add student",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"name\": \"Neha\",\n  \"course\": \"BBA\"\n}" },
        "url": "{{baseUrl}}/students"
      }
    },
    {
      "name": "Update student",
      "request": {
        "method": "PUT",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"name\": \"Rahul Verma\",\n  \"course\": \"MCA\"\n}" },
        "url": "{{baseUrl}}/students/1"
      }
    },
    {
      "name": "Delete student",
      "request": { "method": "DELETE", "url": "{{baseUrl}}/students/1" }
    },
    {
      "name": "Get student - not found (404)",
      "request": { "method": "GET", "url": "{{baseUrl}}/students/99" }
    },
    {
      "name": "Add student - invalid input (400)",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"name\": \"\"\n}" },
        "url": "{{baseUrl}}/students"
      }
    }
  ]
}
